<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.local.weight-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/path/to/weight-sync/.venv/bin/python</string>
    <string>/Users/YOU/path/to/weight-sync/sync.py</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/YOU/path/to/weight-sync/sync.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/path/to/weight-sync/sync.log</string>
</dict>
</plist>
